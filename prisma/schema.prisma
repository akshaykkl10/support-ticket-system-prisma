generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model assignment {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  userid     Int
  assignedat DateTime @db.Timestamp(6)
  ticket     ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model category {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(50)
  ticket ticket[]
}

model comments {
  id        Int      @id @default(autoincrement())
  ticket_id Int
  content   String   @db.VarChar(500)
  userid    Int
  createdat DateTime @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  ticket    ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model customers {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(50)
  email  String   @db.VarChar(100)
  ticket ticket[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model status_history {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  status     String   @db.VarChar(10)
  changed_by Int
  changed_at DateTime @db.Timestamp(6)
  users      users    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket     ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tags {
  id          Int           @id @default(autoincrement())
  name        String?       @unique @db.VarChar(50)
  ticket_tags ticket_tags[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ticket {
  id             Int              @id @default(autoincrement())
  customer_id    Int
  category_id    Int
  title          String           @db.VarChar(200)
  description    String?          @db.VarChar(500)
  priority       String           @db.VarChar(10)
  status         String           @db.VarChar(10)
  createdat      DateTime         @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  updatedat      DateTime         @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  assignment     assignment[]
  comments       comments[]
  status_history status_history[]
  category       category         @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers        @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket_tags    ticket_tags[]

  @@index([title], map: "ticket_title")
}

model ticket_tags {
  ticket_id Int
  tag_id    Int
  tags      tags   @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket    ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([ticket_id, tag_id])
}

model users {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(50)
  email          String           @db.VarChar(100)
  assignment     assignment[]
  comments       comments[]
  status_history status_history[]

  @@index([name], map: "user_name")
}
